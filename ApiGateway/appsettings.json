{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy":"default",
        "Match": {
          "Path": "api/auth/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy":"default",
        "Match": {
          "Path": "api/order/{**catch-all}"
        }
      },
      "suppliers-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy":"default",
        "Match": {
          "Path": "api/suppliers/{**catch-all}"
        }
      },
      "payments-route": {
        "ClusterId": "orders-cluster",
        "AuthorizationPolicy":"default",
        "Match": {
          "Path": "api/payment/{**catch-all}"
        }
      },
      "reports-route": {
        "ClusterId": "inventory-cluster",
        "AuthorizationPolicy":"default",
        "Match": {
          "Path": "api/reports/{**catch-all}"
        }
      },
      "drugs-route": {
          "ClusterId": "inventory-cluster",
          "AuthorizationPolicy":"default",
          "Match": {
            "Path": "api/drugs/{**catch-all}"
          }
        }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:5023/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:5013/"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "d1": {
            "Address": "https://localhost:5080/"
          }
        }
      }
    },

